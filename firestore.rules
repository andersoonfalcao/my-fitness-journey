rules_version = '2';

// Access model: the administrator invites e-mails (invites/{email}); a person signed in with an invited,
// confirmed e-mail reads and writes only their own data (users/{uid}/data/{key}). Google sign-in confirms the
// address by itself; a password account confirms through the e-mail link (else anyone could sign up with an
// invited address, or the administrator's).
// Keep the admin address in sync with ADMIN_EMAIL in src/lib/firebase.ts and strava-worker/wrangler.toml.
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return verified() && email() == 'andersoonfalcao@gmail.com';
    }
    function invited() {
      return isAdmin() || (verified() && exists(/databases/$(database)/documents/invites/$(email())));
    }
    // Every value is one document { json: string, updatedAt: timestamp } (src/lib/cloud-store.ts and the Worker).
    function validData() {
      return request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.updatedAt is timestamp;
    }

    match /invites/{inviteEmail} {
      allow read: if isAdmin() || (verified() && email() == inviteEmail);
      allow write: if isAdmin();
    }

    match /users/{uid}/data/{key} {
      allow read, delete: if invited() && request.auth.uid == uid;
      allow create, update: if invited() && request.auth.uid == uid && validData();
    }
  }
}
