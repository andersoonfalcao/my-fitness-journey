rules_version = '2';

// Access model: the administrator invites e-mails (invites/{email}); a person signed in with an
// invited e-mail reads and writes only their own data (users/{uid}/...). Invited people don't need
// to confirm their e-mail; the administrator does (else anyone could sign up with that address).
// Keep the admin address in sync with ADMIN_EMAIL in src/lib/firebase.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true && email() == 'andersoonfalcao@gmail.com';
    }
    function invited() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/invites/$(email())));
    }

    match /invites/{inviteEmail} {
      allow read: if isAdmin() || (signedIn() && email() == inviteEmail);
      allow write: if isAdmin();
    }

    match /users/{uid}/{document=**} {
      allow read, write: if invited() && request.auth.uid == uid;
    }
  }
}
